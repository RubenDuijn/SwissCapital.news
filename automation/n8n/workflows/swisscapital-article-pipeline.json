{
  "name": "SwissCapital Article Pipeline",
  "nodes": [
    {
      "parameters": {},
      "id": "manual_trigger",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [240, 280]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "return [{ json: { topic: 'AI & Technology', whyNow: 'Large-cap AI capex cycle is accelerating while infrastructure constraints remain binding.', structuralRelevance: 'Capital concentration through compute, power, and policy channels.', format: 'Analytical Essay' } }];"
      },
      "id": "idea_intake",
      "name": "Idea Intake",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [470, 280]
    },
    {
      "parameters": {
        "resource": "chat",
        "model": "gpt-4.1",
        "prompt": "You are SwissCapital Research. Generate a complete article payload JSON with institutional tone and strict structure from this input: {{$json}}"
      },
      "id": "draft_llm",
      "name": "Draft Article (LLM)",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1,
      "position": [710, 280],
      "credentials": {
        "openAiApi": {
          "id": "replace_with_credential_id",
          "name": "OpenAI account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const payload = $json; const text = JSON.stringify(payload).toLowerCase(); const banned = ['game-changing','revolutionary','must-read now','alpha','viral','newsletter-first','creator-led']; const hits = banned.filter((term) => text.includes(term)); payload.scorecard = payload.scorecard || { analyticalDepth: 8, structuralClarity: 8, evidenceDensity: 8, systemicInsight: 8, institutionalTone: hits.length === 0 ? 8 : 5, informationCompression: 8, credibilityPerception: 8, average: 8 }; payload.editorialChecks = payload.editorialChecks || { identityGatePassed: hits.length === 0, thesisGatePassed: true, structuralDepthGatePassed: true, capitalRelevanceGatePassed: true, sourcingGatePassed: true, toneGatePassed: hits.length === 0, originalityGatePassed: true, timelessnessGatePassed: true, bannedPhraseHits: hits }; const minScore = Math.min(payload.scorecard.analyticalDepth, payload.scorecard.structuralClarity, payload.scorecard.evidenceDensity, payload.scorecard.systemicInsight, payload.scorecard.institutionalTone, payload.scorecard.informationCompression, payload.scorecard.credibilityPerception); payload.decision = hits.length === 0 && minScore >= 7 && payload.scorecard.average >= 8 ? 'publish' : 'revise'; return [{ json: payload }];"
      },
      "id": "quality_gate",
      "name": "Quality Gate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [960, 280]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "decision_publish",
              "leftValue": "={{$json.decision}}",
              "rightValue": "publish",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "decision_router",
      "name": "Decision Router",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1180, 280]
    },
    {
      "parameters": {
        "resource": "file",
        "operation": "create",
        "owner": "={{$env.GITHUB_OWNER}}",
        "repository": "={{$env.GITHUB_REPO}}",
        "filePath": "={{'src/content/articles/' + $json.slug + '.json'}}",
        "fileContent": "={{JSON.stringify($json, null, 2)}}",
        "commitMessage": "={{'Add draft article: ' + $json.title}}",
        "branchName": "={{'auto/article-' + $json.slug}}"
      },
      "id": "github_create_file",
      "name": "GitHub Create Article File",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [1410, 200],
      "credentials": {
        "githubApi": {
          "id": "replace_with_credential_id",
          "name": "GitHub account"
        }
      }
    },
    {
      "parameters": {
        "resource": "pullRequest",
        "operation": "create",
        "owner": "={{$env.GITHUB_OWNER}}",
        "repository": "={{$env.GITHUB_REPO}}",
        "title": "={{'Auto draft: ' + $json.title}}",
        "base": "main",
        "head": "={{'auto/article-' + $json.slug}}",
        "body": "={{'Automated draft generated by n8n.\\nDecision: ' + $json.decision + '\\nAverage score: ' + $json.scorecard.average}}"
      },
      "id": "github_create_pr",
      "name": "GitHub Open PR",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [1640, 200],
      "credentials": {
        "githubApi": {
          "id": "replace_with_credential_id",
          "name": "GitHub account"
        }
      }
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "post",
        "channel": "={{$env.SLACK_REVIEW_CHANNEL}}",
        "text": "={{'SwissCapital draft requires revision: ' + ($json.title || 'Untitled') + '\\nDecision: ' + $json.decision + '\\nBanned hits: ' + (($json.editorialChecks && $json.editorialChecks.bannedPhraseHits) ? $json.editorialChecks.bannedPhraseHits.join(', ') : 'none')}}"
      },
      "id": "slack_review_queue",
      "name": "Slack Review Queue",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2,
      "position": [1410, 360],
      "credentials": {
        "slackApi": {
          "id": "replace_with_credential_id",
          "name": "Slack account"
        }
      }
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [
        [
          {
            "node": "Idea Intake",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Idea Intake": {
      "main": [
        [
          {
            "node": "Draft Article (LLM)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Draft Article (LLM)": {
      "main": [
        [
          {
            "node": "Quality Gate",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Quality Gate": {
      "main": [
        [
          {
            "node": "Decision Router",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Decision Router": {
      "main": [
        [
          {
            "node": "GitHub Create Article File",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Slack Review Queue",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "GitHub Create Article File": {
      "main": [
        [
          {
            "node": "GitHub Open PR",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": [
    "swisscapital",
    "editorial",
    "draft-to-pr"
  ]
}
